export const QOBUZ_MODULE_CODE = `
var l="https://qobuz.squid.wtf/api";async function u(e){let r=l+e,i=await fetch(r,{headers:{Accept:"application/json","User-Agent":"Qobuz8Spine/1.0"}});if(!i.ok)throw new Error("[Qobuz] HTTP "+i.status);return await i.json()}function m(e){if(!e)return"Unknown Track";let r=e.title||"Unknown Track";return e.version&&(r+=" ("+e.version+")"),r}function c(e){if(!e)return"Unknown Album";let r=e.title||"Unknown Album";return e.version&&(r+=" ("+e.version+")"),r}function b(e){if(!e)return"Unknown";if(e.maximum_technical_specifications)return e.maximum_technical_specifications;let r=e.maximum_bit_depth||"?",i=e.maximum_sampling_rate||"?",t=e.maximum_channel_count===2?"Stereo":"Unknown";return r+" bits / "+i+" kHz - "+t}async function d(e,r=50,i){try{let t=encodeURIComponent(e),o=await u("/get-music?q="+t+"&offset=0");if(!o.success||!o.data)return console.error("[Qobuz] Invalid response structure"),{tracks:[],total:0};let a=o.data.tracks||{items:[],total:0},s=a.items||[];return{tracks:s.map(n=>({id:String(n.id),title:m(n),artist:n.performer?.name||"Unknown Artist",artistId:n.performer?.id?String(n.performer.id):void 0,album:c(n.album),albumId:n.album?.qobuz_id?String(n.album.qobuz_id):void 0,albumCover:n.album?.image?.large||n.album?.image?.small,duration:n.duration||0,trackNumber:n.track_number,audioQuality:b(n)})),total:a.total||s.length}}catch(t){throw console.error("[Qobuz] Search failed:",t),t}}async function f(e,r,i){try{let t=i.settings?.quality,o=typeof t=="string"?t:t?.value;o||(o="27");let a=await u("/download-music?track_id="+e+"&quality="+o);if(!a.success||!a.data)throw new Error("[Qobuz] Failed to get stream URL");let s=a.data.url;if(!s)throw new Error("[Qobuz] No stream URL found in response");return{streamUrl:s,track:{id:e,audioQuality:"Quality "+o}}}catch(t){throw console.error("[Qobuz] Get stream failed:",t),t}}async function p(e){throw new Error("[Qobuz] Album browsing not available for this module")}return {id:"qobuz",name:"Qobuz (Squid.wtf)",author:"Jawsh",version:"1.0.0",labels:["Hi-Fi","Qobuz","Lossless"],description:"High-quality music streaming from Qobuz via squid.wtf API",settings:{quality:{type:"selector",label:"Audio Quality",description:"Select preferred streaming quality",options:[{label:"Lossy",value:"5"},{label:"Lossless",value:"27"}],defaultValue:"27"}},searchTracks:d,getTrackStreamUrl:f,getAlbum:p};`;
