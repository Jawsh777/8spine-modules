{
  "name": "8spine-module-builder",
  "version": "1.0.0",
  "description": "Project used to help create 8spine modules.",
  "main": "index.js",
  "scripts": {
    "build": "tsx scripts/build-ts.ts",
    "build:watch": "tsx scripts/build-ts.ts --watch",
    "build:minify": "tsx scripts/build-ts.ts --minify",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns=api.test.js",
    "test:all": "jest",
    "test:api": "jest torbox.8spine.api.test.js --forceExit",
    "test:watch": "jest --watch --testPathIgnorePatterns=api.test.js",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=api.test.js",
    "test:verbose": "jest --verbose --testPathIgnorePatterns=api.test.js"
  },
  "keywords": [
    "8spine",
    "music",
    "module",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^25.2.0",
    "esbuild": "^0.27.2",
    "esbuild-plugin-babel": "^0.2.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^29.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "*.8spine",
      "!node_modules/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "verbose": true,
    "testTimeout": 10000,
    "forceExit": true
  },
  "dependencies": {
    "youtubei.js": "^16.0.1"
  }
}
